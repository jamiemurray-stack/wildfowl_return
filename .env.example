# Optional overrides.
#
# This app ships with the *public* Supabase publishable credentials baked in
# (see src/lib/supabase.ts), so it runs with zero configuration. The publishable
# key is safe to expose in a browser bundle — access is controlled by Row Level
# Security on the database, not by hiding this key.
